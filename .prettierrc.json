{
  "plugins": [
    "prettier-plugin-packagejson",
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "printWidth": 100,
  "experimentalOperatorPosition": "start",
  "importOrder": [
    "<BUILTIN_MODULES>",
    "^vue",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/types|^@/utils",
    "^@/composables",
    "^@/components",
    "^[@]",
    "^[.]",
    "^[/]",
    "",
    "<TYPES>^[.@]",
    "<TYPES>"
  ],
  "importOrderTypeScriptVersion": "5.9.3"
}
